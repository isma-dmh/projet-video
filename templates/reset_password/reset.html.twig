{% extends 'base.html.twig' %}

{% block title %}Reset your password
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/reset/request.css') }}">
{% endblock %}

{% block body %}
	<div class="register-form-page">
		<h1 class="page-title">{{"resetForm.title"|trans}}</h1>
		{{ form_start(resetForm) }}
		<div class="form-group">
			{{ form_label(resetForm.plainPassword.first) }}
			{{ form_widget(resetForm.plainPassword.first) }}
            {{ form_errors(resetForm.plainPassword.first) }}
		</div>

		<div class="form-group">
			{{ form_label(resetForm.plainPassword.second) }}
			{{ form_widget(resetForm.plainPassword.second) }}
            {{ form_errors(resetForm.plainPassword.second) }}
		</div>
		<button class="btn-submit">{{"resetForm.submit"|trans}}</button>
		{{ form_end(resetForm) }}
	</div>
{% endblock %}