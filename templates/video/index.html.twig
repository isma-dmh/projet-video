{% extends 'base.html.twig' %}

{% block title %}Video index
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/video/index.css') }}">
{% endblock %}

{% block body %}
	{% if app.user %}

		{% include "layouts/partials/_search_data.html.twig" with {
	formSearch: formSearch
} only %}
		{% if query and videos|length > 0 %}
			<p class="search-results-info">{{ 'video.search.results'|trans({'count': videos|length, 'query': query}) }}</p>
		{% endif %}
	{% endif %}

	<div class="video-grid">
		{% for video in videos %}
			<article class="card-video{% if video.premiumVideo %} premium{% endif %}">
				<div class="thumb-wrap">
					<iframe src="{{video.videoLink}}?mute=1" frameborder="0" title="{{video.title }}"></iframe>
				</div>
				<div class="card-video-body">
					<div class="meta">
						<a href="{{ path('app_video_show', {'id': video.id}) }}" class="title">
							{{ video.title|u.truncate(20," . . .",false) }}
						</a>
						<p class="description">{{ video.description|u.truncate(25,". . .",false) }}</p>
						<p class="stats">{{ video.createdAt|ago }}</p>
						<p class="author">
							{{ 'video.author'|trans }}
							{{ video.user.firstname ~" "~video.user.lastname }}
						</p>
					</div>
				</div>
			</article>
		{% else %}
			<div class="empty-state">
				{% if query is empty %}
					<p>{{ 'video.empty'|trans }}</p>
				{% else %}
					<p>{{ 'video.search.empty'|trans({'query': query}) }}</p>
				{% endif %}
			</div>
		{% endfor %}
	</div>
	<div class="navigation d-flex justify-content-center mb8">
		{{ knp_pagination_render(videos) }}
	</div>
{% endblock %}
