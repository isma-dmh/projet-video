{% extends 'base.html.twig' %}

{% block title %}Video
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/video/show.css') }}">
{% endblock %}

{% block body %}

	<div class="video-show">
		<div class="player-wrap">
			<iframe src="{{ video.videoLink }}" title="Titre de la vidéo" width="640" height="480" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
		</div>

		<div class="video-info">
			<h1 class="title">{{video.title}}</h1>
			<p class="date">{{ video.createdAt|date("d/m/Y") }}</p>
			<p class="author">
				{{"Ajoutée par"|trans}}
				{{ video.user.firstname ~" "~video.user.lastname }}
			</p>
			{% if app.user.email === video.user.email %}
				<div class="video-actions">
					<a href="{{ path('app_video_edit', {id: video.id}) }}" class="btn-video-action">
						<img src="{{asset('svg/edit.svg')}}" alt="edit">
					</a>
					{{ include("video/_delete_form.html.twig") }}
				</div>
			{% endif %}

			<p class="description">{{ video.description }}</p>
		</div>
	</div>

{% endblock %}
