<form method="post" action="{{ path('app_video_delete', {'id': video.id}) }}" class="js-confirm-form" data-confirm="{{ 'profile.delete.confirm'|trans }}">
	<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ video.id) }}">
	<button class="btn-video-action delete">{{ "profile.delete"|trans }}</button>
</form>
