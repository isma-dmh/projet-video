{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('styles/video/formVideo.css') }}">
{% endblock %}

{{ form_start(form) }}

<div class="form-group">
	{{ form_label(form.title) }}
	{{ form_widget(form.title, {'attr': {'class': 'form-input'}}) }}
	{{ form_errors(form.title) }}
</div>

<div class="form-group">
	{{ form_label(form.videoLink) }}
	{{ form_widget(form.videoLink, {'attr': {'class': 'form-input'}}) }}
	{{ form_errors(form.videoLink) }}
</div>

<div class="form-group">
	{{ form_label(form.description) }}
	{{ form_widget(form.description, {'attr': {'class': 'form-textarea', 'rows': 6}}) }}
	{{ form_errors(form.description) }}
</div>

<div class="form-group form-check">
	{{ form_label(form.premiumVideo) }}
	{{ form_widget(form.premiumVideo, {'attr': {'class': 'checkbox-terms'}}) }}
	{{ form_errors(form.premiumVideo) }}
</div>

<div class="form-actions">
	{{ form_widget(form.submit) }}
</div>

{{ form_end(form) }}
